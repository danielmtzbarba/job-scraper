# SQLite is the default for local debugging. Set cloudsql to use PostgreSQL.
JOB_SCRAPER_STORAGE=sqlite
JOB_SCRAPER_DB_PATH=.local/jobs.db
CLOUD_SQL_INSTANCE=jobsearch-danielmtz-2026:europe-west3:jobsearch-postgres
CLOUD_SQL_DATABASE=jobsearch
CLOUD_SQL_IAM_USER=
JOB_SCRAPER_DETAIL_FETCH_INTERVAL=60
JOB_SCRAPER_PROFILE_DIR=.local/profiles
# Required for a live, explicitly triggered Vertex AI scoring run.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
JOB_SCRAPER_VERTEX_MODEL=
JOB_SCRAPER_AUTO_CLASSIFY=0
JOB_SCRAPER_INPUT_PRICE_PER_MILLION=
JOB_SCRAPER_OUTPUT_PRICE_PER_MILLION=
